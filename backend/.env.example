# Copy to backend/.env for local development. NEVER use these values in production.
DATABASE_URL=postgresql://postgres@localhost:54329/ordering
JWT_SECRET=dev-only-change-me-0123456789abcdef
ENVIRONMENT=development

# Seed accounts (python -m seeds.dash) — local development only:
#   super admin: admin / admin-dev-1234
#   Dash owner:  dash / dash-owner-1234
#   Dash staff:  dash.staff / dash-staff-1234
# Production: run the seed with SEED_SKIP_USERS=1 (restaurant + menu only), then
# create the first super admin on the deployed site (/login shows a one-time setup).
